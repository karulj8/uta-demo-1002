{
  "name": "@scayle/storefront-application-nuxt",
  "version": "1.17.1",
  "private": true,
  "description": "SCAYLE Storefront demo shop application based on Nuxt 3",
  "website": "https://scayle.dev/en/core-documentation/storefront-guide/storefront-application/readme/introduction",
  "bugs": {
    "url": "https://github.com/scayle/storefront-application/discussions"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24",
    "pnpm": ">= 11.8.0"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "cms:import": "./scripts/import-cms.sh",
    "cms:sync": "./scripts/sync-cms.sh",
    "dev:https": "nuxt dev --https",
    "dev": "nuxt dev --development",
    "e2e:test": "pnpm --dir ./testing/playwright e2e:test",
    "e2e:ui": "pnpm --dir ./testing/playwright e2e:ui",
    "artillery:load-test": "pnpm --dir ./testing/artillery artillery:load-test",
    "artillery:stress-test": "pnpm --dir ./testing/artillery artillery:stress-test",
    "format:fix": "PRETTIER_EXPERIMENTAL_CLI=1 prettier --ignore-unknown --log-level warn --write .",
    "format": "PRETTIER_EXPERIMENTAL_CLI=1 prettier --ignore-unknown --log-level warn --check .",
    "generate": "nuxt generate",
    "license:overview": "pnpx license-checker-rseidelsohn --csv --out node-licenses.csv",
    "lint:fix": "eslint . --fix",
    "lint": "pnpm eslint .",
    "prepare": "nuxt prepare",
    "preview": "nuxt preview",
    "test:ci": "vitest --run --coverage --reporter=default --reporter=junit --outputFile=./coverage/junit.xml",
    "test": "vitest",
    "typecheck": "nuxt typecheck",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o public/storybook"
  },
  "devDependencies": {
    "@amplience/dc-cli": "0.31.0",
    "@apidevtools/json-schema-ref-parser": "16.0.0",
    "@changesets/cli": "^2.31.1",
    "@contentful/rich-text-types": "17.2.7",
    "@contentstack/cli": "2.0.0",
    "@gtm-support/vue-gtm": "3.2.0",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/kit": "4.5.2",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "3.23.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/storybook": "9.0.1",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@parcel/watcher": "2.6.0",
    "@scayle/changelog-formatter": "1.2.0",
    "@scayle/checkout-types": "2.1.73",
    "@scayle/eslint-config-storefront": "4.8.2",
    "@scayle/eslint-plugin-vue-composable": "1.2.1",
    "@scayle/prettier-config-storefront": "2.1.0",
    "@storybook-vue/nuxt": "9.0.1",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/color": "4.2.1",
    "@types/google.maps": "3.65.5",
    "@types/node": "^24.13.3",
    "@typescript-eslint/scope-manager": "8.67.0",
    "@typescript-eslint/utils": "8.67.0",
    "@upstash/redis": "1.38.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@vue/typescript-plugin": "3.3.10",
    "autoprefixer": "10.5.4",
    "contentful-cli": "4.0.6",
    "eslint": "10.8.1",
    "eslint-formatter-gitlab": "7.2.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-storybook": "10.5.8",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "fishery": "2.4.0",
    "happy-dom": "20.11.2",
    "jiti": "2.7.0",
    "json-schema-to-typescript": "15.0.4",
    "nuxt": "4.5.2",
    "nuxt-svgo": "5.3.0",
    "ofetch": "1.5.1",
    "prettier": "3.9.6",
    "slugify": "1.6.9",
    "storyblok": "4.20.0",
    "storybook": "9.1.20",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "utility-types": "3.11.0",
    "vitest": "4.1.10",
    "vitest-environment-nuxt": "1.0.1",
    "vue-i18n": "11.4.8",
    "vue-tsc": "3.3.10"
  },
  "dependencies": {
    "@contentful/live-preview": "4.10.20",
    "@contentful/rich-text-html-renderer": "17.2.3",
    "@contentstack/delivery-sdk": "5.6.0",
    "@contentstack/live-preview-utils": "4.5.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/scripts": "1.3.4",
    "@scayle/nuxt-image-provider": "1.1.1",
    "@scayle/nuxt-opentelemetry": "1.0.4",
    "@scayle/omnichannel-nuxt": "4.6.2",
    "@scayle/storefront-basket": "0.5.1",
    "@scayle/storefront-country-detection": "2.2.1",
    "@scayle/storefront-navigation": "0.7.1",
    "@scayle/storefront-nuxt": "8.62.5",
    "@scayle/storefront-product-detail": "1.9.3",
    "@scayle/storefront-product-listing": "2.6.0",
    "@scayle/storefront-promotions": "3.4.2",
    "@scayle/storefront-search": "0.5.1",
    "@scayle/unstorage-compression-driver": "1.5.0",
    "@scayle/unstorage-scayle-kv-driver": "3.1.0",
    "@storyblok/nuxt": "11.1.3",
    "@storyblok/richtext": "5.3.0",
    "@storyblok/vue": "11.3.0",
    "@timbenniks/contentstack-endpoints": "3.0.2",
    "@vercel/kv": "3.0.0",
    "@vuelidate/core": "2.0.3",
    "@vuelidate/validators": "2.0.4",
    "@vueuse/components": "14.4.0",
    "@vueuse/core": "14.4.0",
    "@vueuse/gesture": "2.0.0",
    "@vueuse/integrations": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "cf-content-types-generator": "3.0.1",
    "color": "5.0.3",
    "consola": "3.4.2",
    "contentful": "11.12.9",
    "dc-delivery-sdk-js": "1.4.0",
    "defu": "6.1.7",
    "dompurify": "3.4.13",
    "focus-trap": "8.2.2",
    "knitwork": "1.3.0",
    "marked": "18.0.9",
    "nanoid": "6.0.1",
    "pathe": "2.0.3",
    "schema-dts": "1.1.5",
    "storyblok-js-client": "7.7.4",
    "tabbable": "6.5.0",
    "ufo": "1.6.4",
    "unstorage": "1.17.5",
    "valibot": "1.4.2",
    "vue": "3.5.41",
    "vue-slider-component": "4.1.0-beta.7"
  },
  "lint-staged": {
    "./**/*{.js,.mjs,.cjs,.ts,.vue}": [
      "PRETTIER_EXPERIMENTAL_CLI=1 prettier --ignore-unknown --write",
      "eslint --fix"
    ],
    "./**/*{.md,.json,.css}": "PRETTIER_EXPERIMENTAL_CLI=1 prettier --ignore-unknown --write"
  }
}

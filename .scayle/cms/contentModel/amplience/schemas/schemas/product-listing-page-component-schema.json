{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scayle.com/schemas/product-listing-page-component.json",
  "title": "Product Listing Page",
  "description": "A specialized page component for product category/listing pages. It includes both teaser content (shown at the top) and SEO content (shown at the bottom).",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "Content",
        "variant": "outline",
        "items": [
          {
            "label": "Content",
            "pointers": [
              "/teaser_content",
              "/seo_content"
            ]
          },
          {
            "label": "Settings",
            "pointers": [
              "/_meta/deliveryKey",
              "/category"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "deliveryKey": {
          "title": "Slug",
          "description": "The relative URL slug to the specific Product Listing Page, e.g. \"c/c-123456\".",
          "type": "string"
        }
      }
    },
    "teaser_content": {
      "title": "Teaser Content",
      "description": "Content displayed at the top of the product listing page, above the product grid.",
      "type": "array",
      "ui:component": {
        "params": {
          "icons": {
            "text": "typography",
            "slider": "carousel-horizontal",
            "section": "section",
            "image": "photo-plus"
          }
        }
      },
      "items": {
        "oneOf": [
          {
            "title": "Text",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "text",
                "ui:component": "none"
              },
              "text": {
                "title": "Text",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/text-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Slider",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "slider",
                "ui:component": "none"
              },
              "slider": {
                "title": "Slider",
                "description": "Links an existing Slider content item. Modeled as a content relationship rather than inline content so that containers can be re-used across pages without introducing a cyclic schema dependency.",
                "allOf": [
                  {
                    "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                  },
                  {
                    "properties": {
                      "contentType": {
                        "enum": [
                          "https://scayle.com/schemas/slider-component.json"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Section",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "section",
                "ui:component": "none"
              },
              "section": {
                "title": "Section",
                "description": "Links an existing Section content item. Modeled as a content relationship rather than inline content so that containers can be re-used across pages without introducing a cyclic schema dependency.",
                "allOf": [
                  {
                    "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                  },
                  {
                    "properties": {
                      "contentType": {
                        "enum": [
                          "https://scayle.com/schemas/section-component.json"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Image",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "image",
                "ui:component": "none"
              },
              "image": {
                "title": "Image",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/image-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          }
        ]
      }
    },
    "seo_content": {
      "title": "SEO Content",
      "description": "Content displayed at the bottom of the product listing page, after the product grid. Useful for SEO.",
      "type": "array",
      "ui:component": {
        "params": {
          "icons": {
            "video": "video-plus",
            "text": "typography",
            "slider": "carousel-horizontal",
            "section": "section",
            "richText": "article",
            "recentlyViewed": "clock-hour-11",
            "link": "link",
            "image": "photo-plus",
            "divider": "separator",
            "button": "link",
            "accordion": "layout-list"
          }
        }
      },
      "items": {
        "oneOf": [
          {
            "title": "Video",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "video",
                "ui:component": "none"
              },
              "video": {
                "title": "Video",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/video-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Text",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "text",
                "ui:component": "none"
              },
              "text": {
                "title": "Text",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/text-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Slider",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "slider",
                "ui:component": "none"
              },
              "slider": {
                "title": "Slider",
                "description": "Links an existing Slider content item.",
                "allOf": [
                  {
                    "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                  },
                  {
                    "properties": {
                      "contentType": {
                        "enum": [
                          "https://scayle.com/schemas/slider-component.json"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Section",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "section",
                "ui:component": "none"
              },
              "section": {
                "title": "Section",
                "description": "Links an existing Section content item.",
                "allOf": [
                  {
                    "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                  },
                  {
                    "properties": {
                      "contentType": {
                        "enum": [
                          "https://scayle.com/schemas/section-component.json"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Rich Text",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "richText",
                "ui:component": "none"
              },
              "richText": {
                "title": "Rich Text",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/rich-text-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Recently Viewed Products",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "recentlyViewed",
                "ui:component": "none"
              },
              "recentlyViewed": {
                "title": "Recently Viewed Products",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/recently-viewed-products-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Link",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "link",
                "ui:component": "none"
              },
              "link": {
                "title": "Link",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/link-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Image",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "image",
                "ui:component": "none"
              },
              "image": {
                "title": "Image",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/image-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Divider",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "divider",
                "ui:component": "none"
              },
              "divider": {
                "title": "Divider",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/divider-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Button",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "button",
                "ui:component": "none"
              },
              "button": {
                "title": "Button",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/button-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Accordion",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "accordion",
                "ui:component": "none"
              },
              "accordion": {
                "title": "Accordion",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/accordion-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          }
        ]
      }
    }
  },
  "propertyOrder": [
    "_meta",
    "teaser_content",
    "seo_content"
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scayle.com/schemas/page-component.json",
  "title": "Page",
  "description": "The main page component that contains all page content and SEO settings. This is typically the root component for any page.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "Content",
        "variant": "outline",
        "items": [
          {
            "label": "Content",
            "pointers": [
              "/components"
            ]
          },
          {
            "label": "SEO",
            "pointers": [
              "/metaTitle",
              "/metaDescription",
              "/robots"
            ]
          },
          {
            "label": "Settings",
            "pointers": [
              "/_meta/deliveryKey"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "deliveryKey": {
          "title": "Slug",
          "description": "The manually set URL slug for this CMS page. Uses the title to generate the slug automatically if not set manually.",
          "type": "string"
        }
      }
    },
    "components": {
      "title": "Content",
      "description": "Main page content. Add sections, images, text, and other components here.",
      "type": "array",
      "ui:component": {
        "params": {
          "icons": {
            "text": "typography",
            "richText": "article",
            "button": "link",
            "link": "link",
            "divider": "separator",
            "image": "photo-plus",
            "video": "video-plus",
            "productSlider": "shopping-cart",
            "smartSorting": "numbers",
            "recentlyViewed": "clock-hour-11",
            "accordion": "layout-list",
            "grid": "columns-2",
            "slider": "carousel-horizontal",
            "section": "section"
          }
        }
      },
      "items": {
        "oneOf": [
          {
            "title": "Text",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "text",
                "ui:component": "none"
              },
              "text": {
                "title": "Text",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/text-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Rich Text",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "richText",
                "ui:component": "none"
              },
              "richText": {
                "title": "Rich Text",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/rich-text-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Button",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "button",
                "ui:component": "none"
              },
              "button": {
                "title": "Button",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/button-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Link",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "link",
                "ui:component": "none"
              },
              "link": {
                "title": "Link",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/link-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Divider",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "divider",
                "ui:component": "none"
              },
              "divider": {
                "title": "Divider",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/divider-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Image",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "image",
                "ui:component": "none"
              },
              "image": {
                "title": "Image",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/image-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Video",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "video",
                "ui:component": "none"
              },
              "video": {
                "title": "Video",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/video-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Product Slider",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "productSlider",
                "ui:component": "none"
              },
              "productSlider": {
                "title": "Product Slider",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/product-slider-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Smart Sorting Products",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "smartSorting",
                "ui:component": "none"
              },
              "smartSorting": {
                "title": "Smart Sorting",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/smart-sorting-products-slider-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Recently Viewed Products",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "recentlyViewed",
                "ui:component": "none"
              },
              "recentlyViewed": {
                "title": "Recently Viewed Products",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/recently-viewed-products-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Accordion",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "accordion",
                "ui:component": "none"
              },
              "accordion": {
                "title": "Accordion",
                "allOf": [
                  {
                    "$ref": "https://scayle.com/schemas/accordion-component.json"
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Grid",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "grid",
                "ui:component": "none"
              },
              "grid": {
                "title": "Grid",
                "description": "Links an existing Grid content item.",
                "allOf": [
                  {
                    "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                  },
                  {
                    "properties": {
                      "contentType": {
                        "enum": [
                          "https://scayle.com/schemas/grid-component.json"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Slider",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "slider",
                "ui:component": "none"
              },
              "slider": {
                "title": "Slider",
                "description": "Links an existing Slider content item.",
                "allOf": [
                  {
                    "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                  },
                  {
                    "properties": {
                      "contentType": {
                        "enum": [
                          "https://scayle.com/schemas/slider-component.json"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          },
          {
            "title": "Section",
            "type": "object",
            "properties": {
              "componentType": {
                "const": "section",
                "ui:component": "none"
              },
              "section": {
                "title": "Section",
                "description": "Links an existing Section content item.",
                "allOf": [
                  {
                    "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                  },
                  {
                    "properties": {
                      "contentType": {
                        "enum": [
                          "https://scayle.com/schemas/section-component.json"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "componentType"
            ]
          }
        ]
      }
    },
    "metaTitle": {
      "title": "Meta Title",
      "type": "string",
      "minLength": 10,
      "maxLength": 60,
      "description": "Page title for browser tabs and search results. Keep under 60 characters for SEO."
    },
    "metaDescription": {
      "title": "Meta Description",
      "type": "string",
      "minLength": 50,
      "maxLength": 160,
      "description": "Brief page description for search results. Keep under 160 characters."
    },
    "robots": {
      "title": "Robots",
      "type": "string",
      "enum": [
        "index,follow",
        "noindex,follow",
        "index,nofollow",
        "noindex,nofollow"
      ],
      "default": "index,follow",
      "description": "Controls how search engines index this page. Defaults to index/follow."
    }
  },
  "propertyOrder": [
    "_meta",
    "components",
    "metaTitle",
    "metaDescription",
    "robots"
  ]
}
